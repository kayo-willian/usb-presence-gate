[Unit]
Description=USB Presence Gate disposable demonstration service
ConditionPathExists=/run/usbgate/demo-grant

[Service]
Type=simple
ExecStart=/usr/bin/sleep infinity
User=nobody
Group=nogroup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
LimitNOFILE=64
