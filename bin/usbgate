#!/usr/bin/env python3
"""Source checkout and installed entry point."""
import sys
sys.dont_write_bytecode = True
from pathlib import Path
root = Path(__file__).resolve().parent.parent
source = root / "src"
sys.path.insert(0, str(source if (source / "usbgate").is_dir() else root / "lib" / "usbgate"))
from usbgate.cli import main
sys.exit(main())
